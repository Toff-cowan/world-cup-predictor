# Server
PORT=5000
NODE_ENV=development

# PostgreSQL (create DB: createdb world_cup_predictor)
DATABASE_URL=postgresql://postgres:cowanC@localhost:5433/world_cup
# Auth — use a long random string in production
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: protect admin scrape endpoint
ADMIN_SCRAPE_KEY=

# Tournament dates (used to auto-lock finished stages)
TOURNAMENT_START=2026-06-11
TOURNAMENT_END=2026-07-19

# FIFA official API (used by fifa.com — no mock data)
FIFA_API_BASE=https://api.fifa.com
FIFA_COMPETITION_ID=17
FIFA_SEASON_ID=285023
